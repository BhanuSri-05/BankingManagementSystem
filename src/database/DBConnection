package database;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.SQLException;

public class DBConnection {

    private static final String URL = "jdbc:mysql://localhost:3306/banking_system";
    private static final String USER = "root";
    private static final String PASSWORD = "Bhanu@123";

    private DBConnection() {
        // Prevent object creation
    }

    public static Connection getConnection() {

        try {
            Class.forName("com.mysql.cj.jdbc.Driver");

            return DriverManager.getConnection(URL, USER, PASSWORD);

        } catch (ClassNotFoundException e) {
            throw new RuntimeException(
                    "MySQL JDBC Driver not found. Please add mysql-connector-j.jar to the project's lib folder.",
                    e);

        } catch (SQLException e) {
            throw new RuntimeException(
                    "Failed to connect to the database. Check the URL, username, password, and whether MySQL is running.",
                    e);
        }
    }
}
